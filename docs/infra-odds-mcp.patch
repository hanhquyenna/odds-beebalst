From dd594237d7fa2f31a44594f7a763115e75ef33c4 Mon Sep 17 00:00:00 2001
From: Kien Phung <kien.phung@goworkwize.com>
Date: Mon, 12 Oct 2026 18:47:15 +0200
Subject: [PATCH] odds: serve the MCP connector at odds.beeblast.co/mcp
 (CloudFront path to the Supabase function)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 terraform/aws/main.tf                         | 21 +++++++++++++++++++
 terraform/aws/modules/cloudfront/main.tf      | 16 ++++++++++++++
 terraform/aws/modules/cloudfront/variables.tf | 10 +++++++++
 3 files changed, 47 insertions(+)

diff --git a/terraform/aws/main.tf b/terraform/aws/main.tf
index 067a001..cf9076b 100644
--- a/terraform/aws/main.tf
+++ b/terraform/aws/main.tf
@@ -673,6 +673,27 @@ module "cloudfront_odds" {
 
   response_headers_policy_id = aws_cloudfront_response_headers_policy.odds.id
 
+  # odds' connector for Claude and other AI apps (a Supabase Edge Function) under odds' own address:
+  # https://odds.beeblast.co/mcp/... reaches https://<project>.supabase.co/functions/v1/mcp/... so the address people paste into Claude
+  # says odds, and its sign-in addresses match. Nothing is cached, every method and the Authorization header pass through, and the Host
+  # header is the origin's own (AllViewerExceptHostHeader), which Supabase needs.
+  https_origins = [{
+    origin_id   = "SUPABASE-functions"
+    domain_name = trimprefix(var.odds_supabase_url, "https://")
+    origin_path = "/functions/v1"
+  }]
+
+  ordered_cache_behaviors = [{
+    path_pattern             = "/mcp*"
+    target_origin_id         = "SUPABASE-functions"
+    viewer_protocol_policy   = "https-only"
+    compress                 = false
+    allowed_methods          = ["GET", "HEAD", "OPTIONS", "PUT", "POST", "PATCH", "DELETE"]
+    cached_methods           = ["GET", "HEAD"]
+    cache_policy_id          = "4135ea2d-6df8-44a3-9df3-4b5a84be39ad" # Managed-CachingDisabled
+    origin_request_policy_id = "b689b0a8-53d0-40ab-baf2-68738e2966ac" # Managed-AllViewerExceptHostHeader
+  }]
+
   custom_error_responses = [
     {
       error_code            = 403
diff --git a/terraform/aws/modules/cloudfront/main.tf b/terraform/aws/modules/cloudfront/main.tf
index bdeaea5..290cf9b 100644
--- a/terraform/aws/modules/cloudfront/main.tf
+++ b/terraform/aws/modules/cloudfront/main.tf
@@ -119,6 +119,22 @@ resource "aws_cloudfront_distribution" "static_website" {
     }
   }
 
+  dynamic "origin" {
+    for_each = var.https_origins
+    content {
+      origin_id   = origin.value.origin_id
+      domain_name = origin.value.domain_name
+      origin_path = origin.value.origin_path
+
+      custom_origin_config {
+        http_port              = 80
+        https_port             = 443
+        origin_protocol_policy = "https-only"
+        origin_ssl_protocols   = ["TLSv1.2"]
+      }
+    }
+  }
+
   # Ordered cache behaviors (evaluated before the default, in list order)
   dynamic "ordered_cache_behavior" {
     for_each = var.ordered_cache_behaviors
diff --git a/terraform/aws/modules/cloudfront/variables.tf b/terraform/aws/modules/cloudfront/variables.tf
index 87fe9bb..013e2a4 100644
--- a/terraform/aws/modules/cloudfront/variables.tf
+++ b/terraform/aws/modules/cloudfront/variables.tf
@@ -104,6 +104,16 @@ variable "additional_origins" {
   default = []
 }
 
+variable "https_origins" {
+  description = "Additional HTTPS-only origins, optionally with a path prefix added to every request (e.g. an API served under /functions/v1). Route to them with ordered_cache_behaviors."
+  type = list(object({
+    origin_id   = string
+    domain_name = string
+    origin_path = string
+  }))
+  default = []
+}
+
 variable "ordered_cache_behaviors" {
   description = "Ordered cache behaviors evaluated before the default. Each entry routes a path pattern to a specific origin."
   type = list(object({
-- 
