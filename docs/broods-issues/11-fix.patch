+// OpenAI-compatible chat endpoints take images only in user messages: a tool
+// message is text (or, with supportsMultiPartToolContent, parts most servers
+// still ignore), so @ai-sdk/openai-compatible JSON-stringifies a tool result's
+// image into a base64 blob the model cannot see. An MCP screenshot (read_page,
+// a browser tool) then never reaches the model. Move every image file part out
+// of the tool results into one user message right after the tool messages,
+// leaving a short note in the result, so the model sees the picture at the next
+// step the way a person would.
+export const toolImagesAsUserMessageMiddleware: LanguageModelMiddleware = {
+  transformParams: async ({ params }) => {
+    type ImageItem = { toolName: string; data: unknown; mediaType: string };
+    const prompt: typeof params.prompt = [];
+    let pending: ImageItem[] = [];
+    let moved = false;
+    const flush = (): void => {
+      if (pending.length === 0) return;
+      moved = true;
+      prompt.push({
+        role: "user",
+        content: pending.flatMap(({ toolName, data, mediaType }) => [
+          { type: "text" as const, text: `Image returned by ${toolName}:` },
+          { type: "file" as const, data: data, mediaType: mediaType },
+        ]),
+      } as (typeof params.prompt)[number]);
+      pending = [];
+    };
+    for (const message of params.prompt) {
+      if (message.role !== "tool") {
+        // Images from a run of tool messages (parallel calls) join one user
+        // message after the last of them, before whatever comes next.
+        flush();
+        prompt.push(message);
+        continue;
+      }
+      const content = message.content.map((part) => {
+        if (part.type !== "tool-result" || part.output.type !== "content") return part;
+        const kept = part.output.value.filter((item) => {
+          const image = item.type === "file" && /^image(\/|$)/.test(item.mediaType);
+          if (image) pending.push({ toolName: part.toolName, data: item.data, mediaType: item.mediaType });
+          return !image;
+        });
+        if (kept.length === part.output.value.length) return part;
+        return {
+          ...part,
+          output: {
+            ...part.output,
+            value: [...kept, { type: "text" as const, text: "[the image from this result follows in the next user message]" }],
+          },
+        };
+      });
+      prompt.push({ ...message, content: content });
+    }
+    flush();
+
+    return moved ? { ...params, prompt: prompt } : params;
+  },
+};
+
