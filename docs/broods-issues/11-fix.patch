index 0000000..5ca3217
--- /dev/null
+++ b/apps/core/tests/restore-turn-media.test.ts
@@ -0,0 +1,40 @@
+/**
+ * Stored rows keep no media bytes, but the turn they arrive in must still give
+ * the model its pictures: restoreTurnMedia puts them back for the model only.
+ */
+import type { ModelMessage } from "ai";
+import { describe, expect, it } from "bun:test";
+import { restoreTurnMedia } from "../src/harness/session.ts";
+
+const picture = { type: "image" as const, image: "iVBORw0KGgo=", mediaType: "image/png" };
+
+describe("restoreTurnMedia", () => {
+  it("gives this turn's user message its picture back (the stored row had dropped it)", () => {
+    const stored: ModelMessage[] = [
+      { role: "user", content: [{ type: "text", text: "earlier" }] },
+      { role: "assistant", content: [{ type: "text", text: "ok" }] },
+      { role: "user", content: [{ type: "text", text: "what is on the red button?" }, { type: "text", text: "<environment>…</environment>" }] },
+    ];
+    const ingress: ModelMessage[] = [{ role: "user", content: [{ type: "text", text: "what is on the red button?" }, picture] }];
+    const out = restoreTurnMedia(stored, ingress);
+    expect(out[2]!.content).toEqual([
+      { type: "text", text: "what is on the red button?" },
+      { type: "text", text: "<environment>…</environment>" },
+      picture,
+    ]);
+    expect(out[0]).toBe(stored[0]);
+  });
+
+  it("replaces the [attachment not retained] note when the picture was all the message had", () => {
+    const stored: ModelMessage[] = [{ role: "user", content: [{ type: "text", text: "[attachment not retained]" }] }];
+    const out = restoreTurnMedia(stored, [{ role: "user", content: [picture] }]);
+    expect(out[0]!.content).toEqual([picture]);
+  });
+
+  it("leaves links (already stored and rehydrated) and text-only turns alone", () => {
+    const stored: ModelMessage[] = [{ role: "user", content: [{ type: "text", text: "hi" }] }];
+    const link = { type: "image" as const, image: "https://example.com/a.png" };
+    expect(restoreTurnMedia(stored, [{ role: "user", content: [{ type: "text", text: "hi" }, link] }])).toBe(stored);
+    expect(restoreTurnMedia(stored, [{ role: "user", content: "hi" }])).toBe(stored);
+  });
+});
diff --git a/apps/core/tests/tool-images-middleware.test.ts b/apps/core/tests/tool-images-middleware.test.ts
new file mode 100644
index 0000000..0cc661a
--- /dev/null
+++ b/apps/core/tests/tool-images-middleware.test.ts
@@ -0,0 +1,69 @@
+/**
+ * OpenAI-compatible chat endpoints read images only in user messages, so a tool
+ * result's image (an MCP screenshot) is moved into a user message after the
+ * tool messages instead of being JSON-stringified into the tool message.
+ */
+import { describe, expect, it } from "bun:test";
+import { toolImagesAsUserMessageMiddleware } from "../src/harness/provider.ts";
+
+type PromptMessage = { role: string; content: unknown };
+
+async function transform(prompt: PromptMessage[]): Promise<PromptMessage[]> {
+  const result = await toolImagesAsUserMessageMiddleware.transformParams!({
+    params: { prompt: prompt } as never,
+    type: "stream",
+    model: {} as never,
+  });
+
+  return (result as { prompt: PromptMessage[] }).prompt;
+}
+
+const screenshot = { type: "file", data: { type: "data", data: "QUJD" }, mediaType: "image/jpeg" };
+const toolResult = (id: string, value: unknown[]) => ({
+  type: "tool-result",
+  toolCallId: id,
+  toolName: "odds-browser__read_page",
+  output: { type: "content", value: value },
+});
+
+describe("toolImagesAsUserMessageMiddleware", () => {
+  it("moves a tool result's image into a user message right after the tool message", async () => {
+    const prompt = await transform([
+      { role: "user", content: [{ type: "text", text: "apply" }] },
+      { role: "assistant", content: [{ type: "tool-call", toolCallId: "c1", toolName: "odds-browser__read_page", input: {} }] },
+      { role: "tool", content: [toolResult("c1", [{ type: "text", text: "{\"fields\":[]}" }, screenshot])] },
+    ]);
+    expect(prompt.map((m) => m.role)).toEqual(["user", "assistant", "tool", "user"]);
+    const tool = prompt[2]!.content as Array<{ output: { value: Array<{ type: string; text?: string }> } }>;
+    expect(tool[0]!.output.value.map((v) => v.type)).toEqual(["text", "text"]);
+    expect(tool[0]!.output.value[1]!.text).toContain("follows in the next user message");
+    expect(prompt[3]!.content).toEqual([
+      { type: "text", text: "Image returned by odds-browser__read_page:" },
+      { type: "file", data: { type: "data", data: "QUJD" }, mediaType: "image/jpeg" },
+    ]);
+  });
+
+  it("gathers images from parallel tool messages into one user message before the next assistant turn", async () => {
+    const prompt = await transform([
+      { role: "tool", content: [toolResult("c1", [screenshot])] },
+      { role: "tool", content: [toolResult("c2", [screenshot])] },
+      { role: "assistant", content: [{ type: "text", text: "ok" }] },
+    ]);
+    expect(prompt.map((m) => m.role)).toEqual(["tool", "tool", "user", "assistant"]);
+    expect((prompt[2]!.content as unknown[]).length).toBe(4);
+  });
+
+  it("leaves a prompt without tool images untouched", async () => {
+    const original = [
+      { role: "tool", content: [toolResult("c1", [{ type: "text", text: "done" }])] },
+      { role: "tool", content: [{ type: "tool-result", toolCallId: "c2", toolName: "x", output: { type: "text", value: "fine" } }] },
+    ];
+    expect(await transform(original)).toBe(original as never);
+  });
+
+  it("keeps non-image files in the tool result", async () => {
+    const pdf = { type: "file", data: { type: "data", data: "JVBE" }, mediaType: "application/pdf" };
+    const original = [{ role: "tool", content: [toolResult("c1", [pdf])] }];
+    expect(await transform(original)).toBe(original as never);
+  });
+});
