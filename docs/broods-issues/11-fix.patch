+/** Media that carries its own bytes (a base64 picture, a Buffer), not a link. */
+function isByteMedia(part: Exclude<UserModelMessage["content"], string>[number]): boolean {
+  return (
+    (part.type === "image" && !isStorableMediaReference(part.image)) ||
+    (part.type === "file" && !isStorableMediaReference(part.data))
+  );
+}
+
+/**
+ * Puts this turn's byte-backed media back onto its user messages for the model.
+ *
+ * `sanitizeUserMessage` keeps bytes out of stored rows, on the promise that "the
+ * model already saw it in the turn it arrived". But the turn is built from those
+ * rows, so it never did: an image sent on the direct API reached the provider as
+ * text only. This turn's user messages are the newest user messages in the
+ * history, in order; each gets its own media parts back (and loses the
+ * `[attachment not retained]` note that stood in for them). Rows are untouched.
+ */
+export function restoreTurnMedia(
+  messages: ModelMessage[],
+  persisted: ModelMessage[],
+): ModelMessage[] {
+  const turnUsers = persisted.filter(
+    (message): message is UserModelMessage => message.role === "user",
+  );
+  const withMedia = turnUsers.some(
+    (message) =>
+      typeof message.content !== "string" && message.content.some(isByteMedia),
+  );
+  if (!withMedia) return messages;
+  const out = [...messages];
+  let next = turnUsers.length - 1;
+  for (let index = out.length - 1; index >= 0 && next >= 0; index--) {
+    const message = out[index]!;
+    if (message.role !== "user") continue;
+    const original = turnUsers[next--]!;
+    if (typeof original.content === "string") continue;
+    const media = original.content.filter(isByteMedia);
+    if (media.length === 0) continue;
+    const kept =
+      typeof message.content === "string"
+        ? [{ type: "text" as const, text: message.content }]
+        : message.content.filter(
+            (part) => !(part.type === "text" && part.text === ATTACHMENT_NOT_RETAINED),
+          );
+    out[index] = { ...message, content: [...kept, ...media] };
+  }
+
+  return out;
+}
