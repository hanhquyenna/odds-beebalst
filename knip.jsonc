{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "src/**/*.test.{ts,tsx}",
    "scripts/**/*.{ts,mjs}",
    "supabase/functions/*/index.ts",
    "supabase/functions/morning-jobs/match.src.ts",
    // Registered at runtime by src/lib/push.ts.
    "public/sw.js"
  ],
  "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.{ts,mjs}", "supabase/functions/**/*.ts"],
  "ignore": [
    // Vendored shadcn/ui components: kept whole so `shadcn add` updates stay clean.
    "src/components/ui/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    // Playwright is loaded by local QA scripts from a machine path; the e2e suite will import it directly.
    "@playwright/test",
    // Deno specifiers in supabase/functions (jsr:@std/..., npm:web-push), resolved by Deno, not package.json.
    "jsr",
    "npm"
  ],
  // Unresolved imports, unlisted dependencies and missing binaries fail the run. Unused files, dependencies
  // and exports only report for now: a stale-file cleanup is in flight. Flip them to "error" once it lands.
  "rules": {
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
}
