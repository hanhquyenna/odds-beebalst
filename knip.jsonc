{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": ["src/**/*.test.{ts,tsx}", "supabase/functions/*/index.ts", "scripts/**/*.ts"],
  "project": ["e2e/**/*.ts", "src/**/*.{ts,tsx,css}", "scripts/**/*.ts", "supabase/functions/**/*.ts"],
  "ignoreExportsUsedInFile": true,
  // Deno specifiers in supabase/functions (npm:jose), resolved by Deno, not package.json.
  "ignoreDependencies": ["npm"]
}
