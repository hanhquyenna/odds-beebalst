{
  "name": "career-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "e2e": "playwright test",
    "build": "tsc -b && vite build",
    "lint": "oxlint src supabase scripts e2e vite.config.ts playwright.config.ts",
    "knip": "knip --no-progress",
    "check": "tsc -b && bun run lint && knip --no-progress && bun test src",
    "audit": "bun audit --ignore=GHSA-vfj7-8cjw-p6xm --ignore=GHSA-gcqx-w48m-w2h4 --ignore=GHSA-mrhx-c7xc-m3w5",
    "perf": "bun scripts/check-bundles.mjs",
    "preview": "vite preview",
    "test": "bun test src",
    "extension:sync": "rsync -a --delete extension/ \"$HOME/Downloads/odds-extension/\"",
    "e2e:accept": "bun run extension:sync && (lsof -ti :4319 | xargs kill -9 2>/dev/null || true) && CI=1 bunx playwright test --project=desktop --grep @accept",
    "e2e:stress": "bun run extension:sync && (lsof -ti :4319 | xargs kill -9 2>/dev/null || true) && CI=1 bunx playwright test --project=desktop --grep @stress",
    "extension:zip": "cd extension && zip -r ../public/odds-for-chrome.zip . -x '*.DS_Store' -x '*~'",
    "perf": "bun scripts/check-bundles.mjs",
    "bench": "bun scripts/bench.ts",
    "broods:dev": "broods dev",
    "broods:deploy": "broods deploy",
    "broods:whoami": "broods whoami"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@shoojs/auth": "^0.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "@supabase/postgrest-js": "^2.116.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "knip": "^6.39.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9",
    "ip-address": "^10.7.5",
    "qs": "^6.17.1"
  }
}
