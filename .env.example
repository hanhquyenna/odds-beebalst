# Browser bundle. Anon key only, never the service role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local development only: a temporary https link to this computer (for example from cloudflared), so the
# "Add to your phone" QR code opens something a phone can reach while you work on localhost.
# VITE_PUBLIC_URL=https://example.trycloudflare.com

# The WhatsApp group or community link for beta testers; the invite card shows only when this is set.
# VITE_BETA_GROUP_URL=https://chat.whatsapp.com/your-group-code

# Chrome Web Store listing for Odds for Chrome. When set, Connect's "Add to Chrome" opens it.
# Until published, Connect offers /odds-for-chrome.zip (load unpacked in chrome://extensions).
# VITE_CHROME_EXTENSION_URL=https://chromewebstore.google.com/detail/odds/YOUR_ID

# Optional guided video in the first-time Connect tour (YouTube embed / hosted MP4 URL).
# Empty = poster + steps only (no fake video player).
# VITE_EXTENSION_ONBOARD_VIDEO_URL=https://www.youtube.com/embed/VIDEO_ID

# Cloud apply agent (Supabase Edge Function secrets — not Vite). Empty URL = off (none backend).
# Point mcp at the sync Edge Function in this repo (not Broods — Broods is async-only):
#   APPLY_AGENT_WEBHOOK_URL=https://ukpmpyfcnbhngkgbnkxi.supabase.co/functions/v1/apply-agent
# Same bearer on both mcp and apply-agent:
#   APPLY_AGENT_WEBHOOK_SECRET=shared-secret
# APPLY_AGENT_BACKEND=webhook
# Apply decisions use extension rules first, then Broods odds-apply through 9router.
# OPENAI_API_KEY, ANTHROPIC_API_KEY, and APPLY_AGENT_MODEL are not used by this ladder.
# APPLY_AGENT_FORWARD_URL (+ APPLY_AGENT_FORWARD_SECRET) to fan-out lifecycle pings to Broods async.
# Broods Apply agents (structured picks; extension executes). From `bunx broods deploy`:
#   APPLY_AGENT_BROODS_API_KEY=bsk_...                    # BROODS_API_KEY from .env.local
#   APPLY_AGENT_BROODS_AGENT_ID=js74p8xs10efctdq5ynrkm6fmn8gagn5  # production apply-stuck
#   APPLY_AGENT_BROODS_ROAM_AGENT_ID=js76rgrnz12qj43ys5qcnfwnm18gadsy  # free-roam browse
#   APPLY_AGENT_BROODS_USER_TOKEN_SECRET=bsig_...         # BROODS_USER_TOKEN_SECRET
#   APPLY_AGENT_BROODS_BASE_URL=https://gateway.broods.app
# Helper: sh scripts/set-apply-broods-secrets.sh  (needs supabase login)
# Broods project: ./broods (odds-apply / apply-stuck + apply-roam).
