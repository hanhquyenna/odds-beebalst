# Browser bundle. Anon key only, never the service role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local development only: a temporary https link to this computer (for example from cloudflared), so the
