# Browser bundle. Anon key only, never the service role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local development only (never in a build): sign in automatically with this account, so testing needs no form.
# VITE_DEV_EMAIL=you@example.com
# VITE_DEV_PASSWORD=your-password

# Local development only: a temporary https link to this computer (for example from cloudflared), so the
# "Add to your phone" QR code opens something a phone can reach while you work on localhost.
# VITE_PUBLIC_URL=https://example.trycloudflare.com
