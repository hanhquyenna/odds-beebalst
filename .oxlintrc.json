{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  // typeAware adds the typescript/* rules that need types (floating promises, base-to-string). No warnings allowed.
  "options": { "typeAware": true, "maxWarnings": 0 },
  "categories": { "correctness": "error", "suspicious": "error" },
  // match.js is generated by scripts/build-morning-jobs.sh: lint its source, not the bundle.
  "ignorePatterns": ["supabase/functions/jobs/match.js"],
  "rules": {
    "react/rules-of-hooks": "error",

    // Security: no string-to-code paths, no javascript: links, no raw HTML.
    "no-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "react/no-danger": "error",
    "react/jsx-no-script-url": "error",
    "react/jsx-no-target-blank": "error",

    // Off: wrong for this stack, or noise without signal.
    "react/react-in-jsx-scope": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "no-shadow": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/capitalized-calls": "off",
    "no-unmodified-loop-condition": "off",
    "no-underscore-dangle": "off",
    "typescript/consistent-return": "off",
    // Due dates read the clock in render on purpose, so they stay right in a tab left open overnight.
    "react/purity": "off",
    // Fires on render-prop callbacks, which are not components.
    "react/no-unstable-nested-components": "off",
    // Type-aware cast checks misfire here and their autofix breaks tsc.
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/no-misused-spread": ["error", { "allow": ["string"] }]
  },
  "overrides": [
    {
      // No tsconfig covers scripts (data tools), so types resolve loosely there.
      "files": ["scripts/**"],
      "rules": { "typescript/no-base-to-string": "off" }
    }
  ]
}
