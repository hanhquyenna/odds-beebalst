{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "unicorn", "promise", "jsx-a11y"],
  // typeAware runs oxlint-tsgolint for the typescript/* rules that need types (floating promises, base-to-string).
  // maxWarnings is a ratchet: today's count. Fix a warning, then lower it; new code may not add any.
  "options": { "typeAware": true, "maxWarnings": 207 },
  "categories": { "correctness": "error", "suspicious": "error", "perf": "warn" },
  // match.js is generated by scripts/build-morning-jobs.sh: lint its source, not the bundle.
  "ignorePatterns": ["supabase/functions/morning-jobs/match.js", ".claude/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],

    // Security: no string-to-code paths, no javascript: links, no raw HTML.
    "no-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "react/no-danger": "error",
    "react/jsx-no-script-url": "error",
    "react/jsx-no-target-blank": "error",

    // Complexity: limits sit just under today's worst functions, so those warn and the ratchet stops new ones.
    "complexity": ["warn", { "max": 30 }],
    "max-depth": ["warn", { "max": 4 }],
    "max-lines-per-function": ["warn", { "max": 200, "skipBlankLines": true, "skipComments": true }],
    "max-nested-callbacks": ["warn", { "max": 4 }],
    "max-params": ["warn", { "max": 5 }],

    // Spreading a string to code points is how this code takes first letters and counts letters, on purpose.
    "typescript/no-misused-spread": ["error", { "allow": ["string"] }],
    // Stylesheets are imported for their side effect.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],

    // Off: wrong for this stack or too noisy to carry signal.
    // The automatic JSX runtime needs no React in scope.
    "react/react-in-jsx-scope": "off",
    // Hundreds of hits on JSON and DOM boundaries; tsc already checks the casts that matter.
    "typescript/no-unsafe-type-assertion": "off",
    // Style: helpers declared next to their one caller read better than hoisted ones.
    "unicorn/consistent-function-scoping": "off",
    // .sort() on a fresh array (after map/filter/spread) is fine; toSorted would only add a copy.
    "unicorn/no-array-sort": "off",
    // Sequential awaits are deliberate where order or rate limits matter.
    "no-await-in-loop": "off",
    // Shadowing a name in a small callback is idiomatic here.
    "no-shadow": "off",
    "no-underscore-dangle": "off",
    // Style: onload on a fresh FileReader or Image is as clear as addEventListener.
    "unicorn/prefer-add-event-listener": "off",
    // Fires on reverse() of an array just copied with [...x].
    "unicorn/no-array-reverse": "off",
    // False positives: extra deps here are deliberate re-run triggers; react-hooks/exhaustive-deps covers missing ones.
    "react/exhaustive-effect-dependencies": "off",
    // False positive on Date.UTC and other capitalized namespaces.
    "react/capitalized-calls": "off",
    // Misses loop flags flipped by an effect's cleanup closure (the `live` pattern).
    "no-unmodified-loop-condition": "off",
    // TypeScript already types new Array<number>(n), the case this guards against.
    "unicorn/no-new-array": "off",

    // Warn: real but with many existing hits; fix as files are touched.
    "jsx-a11y/prefer-tag-over-role": "warn",
    "jsx-a11y/no-noninteractive-element-interactions": "warn",
    "jsx-a11y/no-autofocus": "warn",
    "jsx-a11y/control-has-associated-label": "warn",
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/no-static-element-interactions": "warn",
    "jsx-a11y/no-noninteractive-tabindex": "warn",
    "jsx-a11y/label-has-associated-control": "warn",
    "react/no-array-index-key": "warn",
    "promise/always-return": "warn",
    "typescript/consistent-return": "warn",
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/no-unnecessary-type-conversion": "warn",
    "oxc/no-map-spread": "warn",
    "react/no-unstable-nested-components": "warn"
  },
  "overrides": [
    {
      // One-off scripts and tests: long setup functions and nested describe blocks are normal there.
      "files": ["scripts/**", "**/*.test.ts", "**/*.test.tsx", "tests/**"],
      "rules": {
        "complexity": "off",
        "max-depth": "off",
        "max-lines-per-function": "off",
        "max-nested-callbacks": "off",
        "max-params": "off"
      }
    },
    {
      // Local QA scripts import Playwright from a machine path on purpose.
      "files": ["scripts/qa/**"],
      "rules": { "import/no-absolute-path": "off" }
    },
    {
      // Audit scripts print whatever a row holds.
      "files": ["scripts/**"],
      "rules": { "typescript/no-base-to-string": "warn" }
    },
    {
      // No tsconfig covers these (tests are excluded, Deno imports by URL), so types resolve loosely and these rules misfire.
      "files": ["scripts/**", "supabase/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": { "typescript/no-unnecessary-type-assertion": "off", "typescript/no-unnecessary-type-conversion": "off" }
    }
  ]
}
