{
  "manifest_version": 3,
  "name": "odds: interview chances beside jobs",
  "short_name": "odds",
  "version": "0.13.0",
  "description": "See your interview chance beside jobs on LinkedIn, Indeed, Glassdoor, Magnet.me and employers' own job pages. Click a percentage to view that job in the Odds side panel.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "odds",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://ukpmpyfcnbhngkgbnkxi.supabase.co/*",
    "https://odds.beeblast.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*"
      ],
      "js": [
        "job-sites.js",
        "site-dom.js",
        "panel.js",
        "content-job.js",
        "application-handoff.js",
        "apply.js"
      ],
      "css": [
        "content-job.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*/*"
      ],
      "exclude_matches": [
        "https://*.linkedin.com/*",
        "https://odds.beeblast.co/*"
      ],
      "js": [
        "job-sites.js",
        "site-dom.js",
        "panel.js",
        "content-job.js",
        "application-handoff.js",
        "apply-any.js"
      ],
      "css": [
        "content-job.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://odds.beeblast.co/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "content-site.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.successfactors.eu/*",
        "https://*.successfactors.com/*",
        "https://*.icims.com/*"
      ],
      "js": [
        "job-sites.js",
        "application-handoff.js",
        "apply-any.js"
      ],
      "css": [
        "content-job.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/inter-tight.woff2",
        "panel.html",
        "panel-frame.js",
        "panel-frame.css"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "minimum_chrome_version": "120"
}
